# Launch Detective — environment variables (copy to .env.local; never commit real keys)

# Optional. Without a key the app runs in clearly labeled "Scripted demo mode".
ANTHROPIC_API_KEY=

# Optional. Tool-capable Claude model used by /api/investigate (server-side only).
ANTHROPIC_MODEL=claude-opus-5-5

# Optional. low | medium | high — lower is faster for short, grounded explanations.
LD_AI_EFFORT=low

# Optional. Set to 1 to let the server try live Launch Library 2 / Open-Meteo adapters.
# The demo mission always works from local fixtures regardless of this setting.
LD_ENABLE_LIVE_DATA=0
